# Site URL (used for Polar checkout redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Postgres) — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# Dodo Payments (https://dodopayments.com)
# Create a product in Dodo Payments Dashboard with "Pay What You Want" / custom amount enabled.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
# "test_mode" (default) or "live_mode"
DODO_PAYMENTS_ENVIRONMENT=test_mode


